#!/bin/sh
# Builds the release assets into dist/, in the toolchain (scripts/dev): heavy-cmd-linux-x86_64, a static
# (musl) binary, and heavy-cmd-windows-x86_64.exe. Then checks each runs and names Cargo.toml's version
# (the Windows one under Wine).
#
#   heavy-cmd -- scripts/pack
set -eu
exec "$(dirname "$0")/dev" sh -euc '
version=$(sed -n "s/^version = \"\(.*\)\"$/\1/p" Cargo.toml | head -n 1)
linux=x86_64-unknown-linux-musl
windows=x86_64-pc-windows-gnu
cargo build --locked --release --target $linux
cargo build --locked --release --target $windows
rm -rf dist
mkdir dist
cp target/$linux/release/heavy-cmd dist/heavy-cmd-linux-x86_64
cp target/$windows/release/heavy-cmd.exe dist/heavy-cmd-windows-x86_64.exe

# Run with nothing to run, each prints its usage, whose first line names its version.
said=$(dist/heavy-cmd-linux-x86_64 2>&1 | head -n 1 | cut -d: -f1)
[ "$said" = "heavy-cmd v$version" ] || { echo "pack: the Linux binary says \"$said\"" >&2; exit 1; }
said=$(wine dist/heavy-cmd-windows-x86_64.exe 2>&1 | tr -d "\r" | grep "^heavy-cmd v" | head -n 1 | cut -d: -f1)
[ "$said" = "heavy-cmd v$version" ] || { echo "pack: the Windows binary says \"$said\"" >&2; exit 1; }
ls -l dist
'
